{
  "name": "ts-agentic-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "BSD-2-Clause",
  "author": "Balajee.R.C",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "check": "vp check && vp test run --coverage",
    "fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "build": "vp pack",
    "hooks:install": "vp hooks enable",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "5.0.1",
    "pino-pretty": "^13.1.3",
    "vite-plus": "1.0.0"
  }
}
