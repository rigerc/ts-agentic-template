# The heavier half of the gate.
#
# There is no CI here, so this hook and `pre-commit` are the whole of it. Be
# honest about what that means: `git push --no-verify` walks straight past this,
# and nothing downstream will notice. It is a gate you choose to keep, not one
# imposed on you.
#
# `pre-commit` runs `npm run check` on every commit. This runs the things that are
# too slow for that, plus the two scans that used to live in CI.

set -e

if [ ! -x .tools/gitleaks ]; then
  echo "gitleaks is not installed. Run: npm run tools:install" >&2
  exit 1
fi

echo "==> Scanning history for secrets"
npm run scan:secrets

echo "==> Auditing dependencies"
npm run check:vulnerabilities

echo "==> Building"
npm run build

echo "==> Mutation testing"
npm run test:mutation
