{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tui-spec/1.0.0/manifest.schema.json",
  "title": "manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "entry_screen": {
      "type": "string",
      "minLength": 1
    },
    "source_brief": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_mode": {
      "enum": [
        "brief",
        "existing-app"
      ]
    },
    "artifact_scope": {
      "enum": [
        "full",
        "contracts-only"
      ]
    }
  },
  "required": [
    "schema_version",
    "feature_id",
    "title",
    "status",
    "source_brief",
    "files",
    "assumptions",
    "open_questions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_scope": {
            "const": "contracts-only"
          }
        },
        "required": [
          "artifact_scope"
        ]
      },
      "then": {
        "properties": {
          "source_mode": {
            "const": "existing-app"
          }
        },
        "required": [
          "source_mode"
        ]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "artifact_scope": {
              "const": "contracts-only"
            }
          },
          "required": [
            "artifact_scope"
          ]
        }
      },
      "then": {
        "required": [
          "entry_screen"
        ]
      }
    }
  ]
}
