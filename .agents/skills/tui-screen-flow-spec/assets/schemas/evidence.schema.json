{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tui-spec/1.0.0/evidence.schema.json",
  "title": "source provenance for existing-app contracts",
  "type": "object",
  "required": [
    "schema_version",
    "claims",
    "gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "classification",
          "rationale",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "observed",
              "user-confirmed",
              "inferred",
              "proposed"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "line_start",
                "line_end"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "code",
                    "test",
                    "config",
                    "doc"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "answered",
              "out-of-scope"
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "impact_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
