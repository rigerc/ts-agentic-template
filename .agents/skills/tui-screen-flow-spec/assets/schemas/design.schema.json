{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tui:design:1.1.0",
  "title": "Optional TUI visual configuration (1.0 and 1.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "componentProps": {"type":"object", "additionalProperties":{"type":"object"}},
    "componentMappings": {"type":"object", "propertyNames":{"pattern":"^[a-z][a-z0-9-]*$"}, "additionalProperties":{"type":"string", "pattern":"^(ink|opentui)/[a-z0-9][a-z0-9-]*$"}},
    "themes": {"type":"object", "propertyNames":{"pattern":"^[a-z][a-z0-9_-]*$"}, "additionalProperties":{"type":"object", "additionalProperties":false, "required":["bg","panel","fg","muted","accent","border","error"], "properties":{"bg":{"$ref":"#/$defs/color"},"panel":{"$ref":"#/$defs/color"},"fg":{"$ref":"#/$defs/color"},"muted":{"$ref":"#/$defs/color"},"accent":{"$ref":"#/$defs/color"},"border":{"$ref":"#/$defs/color"},"error":{"$ref":"#/$defs/color"}}}},
    "preview": {"type":"object", "additionalProperties":false, "properties":{
      "viewports":{"type":"object", "minProperties":1, "propertyNames":{"$ref":"#/$defs/name"}, "additionalProperties":{"type":"object", "additionalProperties":false, "required":["cols","rows"], "properties":{"cols":{"type":"integer","minimum":20,"maximum":240},"rows":{"type":"integer","minimum":8,"maximum":90}}}},
      "layouts":{"type":"object", "additionalProperties":{"$ref":"#/$defs/layout"}},
      "styles":{"type":"object", "additionalProperties":{"$ref":"#/$defs/style"}},
      "outputs":{"type":"array", "minItems":1, "uniqueItems":true, "items":{"enum":["txt","svg","ansi","html"]}}
    }}
  },
  "allOf":[{"if":{"properties":{"schema_version":{"const":"1.0.0"}}},"then":{"not":{"required":["preview"]}}}],
  "$defs":{
    "name":{"pattern":"^[a-z][a-z0-9-]*$"},
    "color":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},
    "width":{"oneOf":[{"type":"integer","minimum":1,"maximum":240},{"type":"string","pattern":"^([1-9][0-9]?|100)%$"}]},
    "layout":{"type":"object","additionalProperties":false,"properties":{"direction":{"enum":["horizontal","vertical","grid","overlay"]},"columns":{"type":"integer","minimum":1,"maximum":12},"width":{"$ref":"#/$defs/width"},"padding":{"type":"integer","minimum":0,"maximum":20},"gap":{"type":"integer","minimum":0,"maximum":20},"border":{"enum":["none","single","rounded","double"]},"align":{"enum":["left","center","right"]},"valign":{"enum":["top","center","bottom"]},"byViewport":{"type":"object","propertyNames":{"$ref":"#/$defs/name"},"additionalProperties":{"type":"object"}}}},
    "style":{"type":"object","additionalProperties":false,"properties":{"width":{"$ref":"#/$defs/width"},"padding":{"type":"integer","minimum":0,"maximum":20},"border":{"enum":["none","single","rounded","double"]},"align":{"enum":["left","center","right"]},"role":{"enum":["fg","muted","accent","border","error"]},"wrap":{"type":"boolean"},"maxHeight":{"type":"integer","minimum":1,"maximum":90},"maxItems":{"type":"integer","minimum":0,"maximum":100},"columns":{"type":"array","items":{"type":"string"}},"byViewport":{"type":"object","propertyNames":{"$ref":"#/$defs/name"},"additionalProperties":{"type":"object"}}}}
  }
}
