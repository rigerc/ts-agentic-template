ignore-scripts=true
min-release-age=30
# Scoped exception for the pinned Vite+ 1.5.0 toolchain (2026-11-04 release).
# Review these after the 30-day window has elapsed.
min-release-age-exclude[]=vite-plus
min-release-age-exclude[]=@voidzero-dev/vite-plus-core
min-release-age-exclude[]=vitest
min-release-age-exclude[]=@vitest/coverage-v8
allow-git=none
allow-remote=none
allow-file=none
